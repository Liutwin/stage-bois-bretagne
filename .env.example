# Port d'écoute du serveur backend (défaut : 8000)
PORT=8000

# Chemin vers le fichier SQLite (défaut : data/db.sqlite, relatif au dossier backend/)
DB_PATH=data/db.sqlite

# --- Configuration SMTP (compte noreply) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Mettre à "true" pour TLS direct (port 465), laisser vide ou "false" pour STARTTLS (port 587)
SMTP_SECURE=false
NOREPLY_MAIL_USER=votre@email.com
NOREPLY_MAIL_PASSWORD=votre_mot_de_passe

# Adresse email de la cliente (destinataire des messages de contact et notifications)
CLIENT_EMAIL=votre@email.com
